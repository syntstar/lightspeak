{
  "name": "lightspeak-client",
  "private": true,
  "version": "1.0.0",
  "description": "Lightspeak – self-hosted voice chat, text chat and screen sharing",
  "license": "AGPL-3.0-only",
  "repository": "github:syntstar/lightspeak",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build --mode web",
    "dev:web": "vite build --mode web --watch",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,svelte,css}\"",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\"",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@lucide/svelte": "1.66.0",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-opener": "2.7.2",
    "highlight.js": "11.12.0",
    "livekit-client": "^2.23.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
