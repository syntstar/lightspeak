# Lightspeak server settings: template with the default values.
#
# On a server these lines live in /etc/lightspeak/server.env. install.sh writes
# that file; add your own values below its "# --- own settings ---" marker and
# remove the "# " in front. Then:
#
#   sudo lightspeak-admin config          # check the values (shows typos too)
#   sudo systemctl restart lightspeak-server
#
# The same keys work in an answers file (sudo bash install.sh --config answers.env).
# Protective limits (rate limits, image sizes, WebSocket frames) are fixed on
# purpose: a wrong value there opens the server to abuse.

# ---------- who may do what ----------

# Who may create accounts:
#   admin   only invites from server admins or the command line
#   invite  every valid invite
#   closed  nobody (except the owner invite from `bootstrap`)
# LS_SIGNUP=admin

# Who may create invites to a space:
#   members  everyone with the space permission "Invite people"
#   admins   only server admins and `lightspeak-admin create-invite`; links
#            other people made earlier stop working
# LS_INVITES=members

# ---------- capacity ----------

# Spaces a regular account may own, 0-100. 0 = only server admins create
# spaces; server admins are not limited.
# LS_MAX_SPACES=3

# Characters per message, 100-20000.
# LS_MAX_MESSAGE_CHARS=4000

# Members per space, 2-1000.
# LS_MAX_SPACE_MEMBERS=500

# Channels per space including categories, 10-1000.
# LS_MAX_SPACE_CHANNELS=200

# Roles per space, 2-100.
# LS_MAX_SPACE_ROLES=25

# ---------- these two reach further than the server ----------
# LiveKit and Caddy read their own limits from these values. After a change run
# `sudo lightspeak-admin reconfigure`, a restart alone is not enough. In
# server.env they stand above the marker; change them in place.

# People in one voice channel, 2-100. Each stream multiplies server traffic.
# LS_MAX_VOICE_PARTICIPANTS=25

# Largest upload in MB, 1-51200.
# LS_MAX_UPLOAD_MB=200

# ---------- storage ----------

# Space for attachments in GB; uploads are refused when it is full.
# LS_STORAGE_QUOTA_GB=4

# Delete attachments after this many days, 0 = keep them.
# LS_RETENTION_DAYS=0

# ---------- clients ----------

# Ask older apps to update.
# LS_MIN_CLIENT_VERSION=0.1.0

# Download link on the landing page when this server hosts no installer.
# LS_DOWNLOAD_URL=https://github.com/syntstar/lightspeak/releases/latest/download/Lightspeak-setup.exe

# Further allowed web origins, comma separated.
# LS_EXTRA_ORIGINS=
